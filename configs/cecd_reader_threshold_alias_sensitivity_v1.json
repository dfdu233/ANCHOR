  "estimands": {
    "threshold_free_product_existence": {
      "quantity": "raw_fp32_interaction_rms_and_identity_normalized_interaction_rms",
      "reader_labels_used": false,
      "purpose": "separate existence of a product interaction from its clinical orientation"
    },
    "continuous_panel_support": {
      "target": "q=(R8+R9+R10)/3",
      "calibrators": [
        "dev_only_fractional_logistic_by_model_finding",
        "dev_only_isotonic_by_model_finding"
      ],
      "confirmation_quantity": "mean[proper_loss(q,g(m_actual))-proper_loss(q,g(m_additive))]",
      "proper_losses": ["bernoulli_cross_entropy_with_fractional_target", "brier"],
      "m_additive": "m_actual-two_way_centered_interaction",
      "positive_direction": "product_interaction_increases_reader_support_loss"
    },
    "leave_one_reader_out": {
      "targets": ["q_without_R8", "q_without_R9", "q_without_R10"],
      "target_values": [0.0, 0.5, 1.0],
      "fit": "each calibrator fit on dev without the omitted reader and applied once to confirmation",
      "inference_scope": "fixed_panel_sensitivity_not_reader_population_inference"
    },
    "cumulative_threshold_sweep": {
      "targets": ["1[votes>=1]", "1[votes>=2]", "1[votes>=3]"],
      "fit": "three dev_only calibrators_applied_once_to_confirmation",
      "purpose": "test whether clinical orientation exists only under unanimity or majority discretization"
    },
    "exact_reader_pattern_absorption": {
      "baseline": "clean_score+both_marginals+generic_stability+behavioral_synergy+vote_count+named_reader_pattern_by_model_finding",
      "increment": "harmful_and_absolute_product_interaction",
      "purpose": "test CECD increment after the strongest available fixed-panel identity control",
      "reuse": "reader_threshold_aliasing_control_v1_design_only"
    }
  },
  "inference": {
    "primary_cluster_unit": "whole_image_id",
    "models_resampled_synchronously": true,
    "findings_within_image_kept_together": true,
    "confirmation_bootstrap_draws": 5000,
    "confirmation_bootstrap": "paired_whole_image_with_frozen_dev_fit",
    "dev_fit_uncertainty_audit_draws": 1000,
    "dev_fit_uncertainty_audit": "nested_dev_image_refit_plus_paired_confirmation_image_resample",
    "reader_bootstrap": false,
    "reader_bootstrap_reason": "three fixed readers do not identify a reader-population sampling distribution",
    "patient_cluster_available": false,
    "claim_scope_when_patient_mapping_absent": "radiograph_level_not_patient_level"
  },
  "falsification": {
    "alias_robust_clinical_product_claim_requires": [
      "continuous_panel_support_product_loss_increase_ci_low_above_zero_for_both_models_under_both_calibrators",
      "leave_one_reader_out_pooled_ci_low_above_zero_and_same_positive_point_direction_for_all_six_model_by_omitted_reader_cells",
      "cumulative_threshold_point_direction_positive_for_all_thresholds_and_models_with_at_least_two_of_three_ci_lows_above_zero_per_model",
      "exact_reader_pattern_adjusted_product_increment_ci_low_above_zero_for_both_models"
    ],
    "failure_action": "retain_raw_product_instability_if_present_but_terminate_reader_grounded_product_specific_mechanism_claim",
